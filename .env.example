# ============================================================================
# Emotion Data Studio — environment template
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in your real values.
# NEVER commit `.env` or any Google Service Account JSON key.
# ============================================================================

# ----------------------------------------------------------------------------
# Gemini / Vertex AI (AI Auto-Cut feature)
# ----------------------------------------------------------------------------
# Choose ONE of the two auth methods below. Vertex AI is recommended for
# production use; the API key path is fine for prototyping.

# --- Option A: Vertex AI with Service Account ---
# Path to the JSON key file downloaded from Google Cloud Console.
# The key file itself MUST NOT be committed — see `.gitignore`.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Gemini API key (simpler, but rate-limited) ---
# GEMINI_API_KEY=your-api-key-here

# ----------------------------------------------------------------------------
# Gemini tuning
# ----------------------------------------------------------------------------
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=8192
GEMINI_INTENSITY_THRESHOLD=0.6
GEMINI_MONTHLY_BUDGET_USD=500.0
GEMINI_COST_TRACKING_ENABLED=true

# ----------------------------------------------------------------------------
# Application paths (optional overrides)
# ----------------------------------------------------------------------------
# EDS_DATA_DIR=
# FFMPEG_PATH=
# MODEL_CACHE_DIR=

# ----------------------------------------------------------------------------
# Cloud Run / GCS (only if deploying backend to Cloud Run)
# ----------------------------------------------------------------------------
# GCS_BUCKET_NAME=your-bucket
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# ============================================================================
# After editing this file, rename it to `.env`:
#   cp .env.example .env       (Linux/Mac)
#   Copy-Item .env.example .env (PowerShell)
# ============================================================================